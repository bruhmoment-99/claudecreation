## @file
#  LabSmmHandler - TRADITIONAL MM build (DXE_SMM_DRIVER). The SMM core loads
#  it from the firmware volume into SMRAM during DXE. Phases 4 and 6.
#  The Standalone MM build of the same code is LabMmHandlerStandalone.inf.
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LabSmmHandler
  FILE_GUID                      = 4d625791-9b16-48ee-841d-ba1959275b93
  MODULE_TYPE                    = DXE_SMM_DRIVER
  VERSION_STRING                 = 1.0
  PI_SPECIFICATION_VERSION       = 0x0001000A
  ENTRY_POINT                    = LabSmmHandlerEntry

[Sources]
  LabMmCommon.h
  LabSmmHandler.c
  LabSmmEntryTraditional.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LabSmmPkg/LabSmmPkg.dec

[LibraryClasses]
  BaseLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  SmmServicesTableLib
  SmmMemLib
  BaseMemoryLib
  IoLib
  DebugLib

[Guids]
  gLabSmmCommGuid

[Protocols]
  gEfiSmmAccess2ProtocolGuid      ## CONSUMES (at entry, to learn the SMRAM ranges)
  gEfiSmmVariableProtocolGuid     ## CONSUMES (SMM-side variable read/write, Phase 6)
  gEdkiiSmmVarCheckProtocolGuid   ## CONSUMES (mark LabBootCounter read-only for ring 0)

[Depex]
  gEfiSmmAccess2ProtocolGuid AND
  gEfiSmmVariableProtocolGuid AND
  gEdkiiSmmVarCheckProtocolGuid
