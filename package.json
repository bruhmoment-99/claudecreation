    "bot",
    "schematic",
    "litematica"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bruhmoment-99/claudecreation/issues"
  },
  "homepage": "https://github.com/bruhmoment-99/claudecreation#readme",
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.2.0"
  },
  "bin": {
